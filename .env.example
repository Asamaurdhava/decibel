# Decibel — Environment Variables
# Copy this to .env.local and fill in your keys

# Mapbox (for community noise map)
# Get yours at: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Anthropic Claude API (for AI hearing risk analysis)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase (for community data persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
